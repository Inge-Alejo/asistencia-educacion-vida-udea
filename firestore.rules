rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de validación de campos mínimos y límites de tamaño (Protección contra DoS)
    function isValidAttendance() {
      return request.resource.data.documento is string &&
             request.resource.data.documento.size() >= 4 &&
             request.resource.data.documento.size() <= 25 &&
             request.resource.data.nombreCompleto is string &&
             request.resource.data.nombreCompleto.size() >= 2 &&
             request.resource.data.nombreCompleto.size() <= 120 &&
             request.resource.data.eventoId is string &&
             request.resource.data.eventoId.size() <= 50;
    }

    // Colección de Asistencias:
    // Sincronización multi-dispositivo en tiempo real (móvil, tablet, PC de mesa)
    match /asistencias/{asistenciaId} {
      allow read, write: if true;
    }

    // Colección de Verificaciones Públicas Seguras (Escarapelas Digitales)
    match /verificaciones/{verificacionId} {
      allow read, write: if true;
    }

    // Colección de Preguntas a Ponentes (Live Q&A)
    match /preguntas/{preguntaId} {
      allow read, write: if true;
    }

    // Colección de Evaluaciones de Ponentes
    match /evaluaciones/{evalId} {
      allow read, write: if true;
    }

    // Colección de Encuestas de Satisfacción
    match /satisfaccion/{satId} {
      allow read, write: if true;
    }

    // Colección de Entregas de Alimentación / Refrigerios
    match /entregas_comidas/{entregaId} {
      allow read, write: if true;
    }

    // Colección de Eventos Académicos
    match /eventos/{eventoId} {
      allow read, write: if true;
    }

    // Colección de Listas de Inscritos Oficiales (Excel / CSV)
    match /inscritos/{eventoId} {
      allow read, write: if true;
    }
  }
}
